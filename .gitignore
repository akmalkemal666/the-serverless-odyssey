# ============================================================
#  .gitignore — The Serverless Odyssey
#  Stack: Next.js 16 · Supabase · Cloudinary · Vercel Edge
#  Maintainer: DevSecOps Standard v2.0
# ============================================================

# ─────────────────────────────────────────
# 🔐 DEVSECOPS — SECRETS & CREDENTIALS
# NEVER commit any of these files!
# ─────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
secrets/
credentials/
serviceAccountKey.json

# ─────────────────────────────────────────
# ⚡ NEXT.JS 16 — BUILD & CACHE ARTIFACTS
# ─────────────────────────────────────────
.next/
out/
build/
dist/
.vercel/
*.tsbuildinfo
next-env.d.ts

# Turbopack cache (Next.js 16)
.turbo/
.turbo-cache/

# ─────────────────────────────────────────
# 📦 NODE.JS — DEPENDENCIES & LOCK FILES
# ─────────────────────────────────────────
node_modules/
.npm/
.pnpm-store/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.cjs
.pnp.loader.mjs
# Keep lock files (package-lock.json / yarn.lock / pnpm-lock.yaml) committed!

# ─────────────────────────────────────────
# 🧪 TESTING & COVERAGE
# ─────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
playwright/.cache/
cypress/screenshots/
cypress/videos/

# ─────────────────────────────────────────
# 🗄️ SUPABASE — LOCAL DEV ARTIFACTS
# ─────────────────────────────────────────
supabase/.branches/
supabase/.temp/
supabase/docker/volumes/

# ─────────────────────────────────────────
# ☁️  CLOUDINARY — UPLOAD TEMP
# ─────────────────────────────────────────
.cloudinary/
uploads/tmp/

# ─────────────────────────────────────────
# 🛠️  EDITORS & IDE FILES
# ─────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.vim

# ─────────────────────────────────────────
# 🖥️  OPERATING SYSTEM TEMP FILES
# ─────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ─────────────────────────────────────────
# 📝 LOGS & DEBUG FILES
# ─────────────────────────────────────────
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
logs/
log/

# ─────────────────────────────────────────
# 🔬 STORYBOOK & CHROMATIC
# ─────────────────────────────────────────
storybook-static/
.chromatic/

# ─────────────────────────────────────────
# 📊 MISC TOOL CACHES
# ─────────────────────────────────────────
.eslintcache
.stylelintcache
.prettiercache
*.tgz
*.tar.gz
.cache/
tmp/
temp/
