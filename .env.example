# ============================================================
#  .env.example — The Serverless Odyssey
#  AMAN untuk di-commit ke repo publik!
#  ⚠️  Salin file ini ke .env.local, lalu isi dengan nilai asli
#      JANGAN pernah commit .env.local ke Git!
# ============================================================

# ─────────────────────────────────────────
# 🗄️  SUPABASE — Cloud PostgreSQL
# Dapatkan nilai dari: https://app.supabase.com/project/_/settings/api
# ─────────────────────────────────────────

# URL project Supabase Anda (format: https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/Public Key — aman untuk diekspos di client-side
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Service Role Key — RAHASIA MUTLAK, hanya untuk server-side!
# ⛔ JANGAN gunakan di komponen client atau expose ke browser
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# JWT Secret (opsional, untuk validasi token custom)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ─────────────────────────────────────────
# ☁️  CLOUDINARY — Media CDN
# Dapatkan dari: https://console.cloudinary.com/settings/api-keys
# ─────────────────────────────────────────

# Cloud Name — Identitas unik akun Cloudinary Anda
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

# API Key — Digunakan untuk autentikasi server-side
CLOUDINARY_API_KEY=your-cloudinary-api-key

# API Secret — RAHASIA MUTLAK, hanya untuk server-side!
# ⛔ JANGAN ekspos ke browser atau sertakan dalam bundle client
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Upload Preset (opsional, untuk unsigned uploads dari client)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-upload-preset-name

# ─────────────────────────────────────────
# 🚀 VERCEL — Deployment & Edge Runtime
# Variabel ini di-inject otomatis oleh Vercel saat deploy
# Referensi: https://vercel.com/docs/projects/environment-variables/system-environment-variables
# ─────────────────────────────────────────

# URL deployment (otomatis di-set oleh Vercel)
# NEXT_PUBLIC_VERCEL_URL=https://your-project.vercel.app

# Environment (development | preview | production)
# VERCEL_ENV=development

# ─────────────────────────────────────────
# 🔐 NEXT.JS — App Security
# ─────────────────────────────────────────

# Secret acak untuk NextAuth.js / custom session (min 32 karakter)
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars

# URL canonical aplikasi (wajib untuk NextAuth.js)
NEXTAUTH_URL=http://localhost:3000

# ─────────────────────────────────────────
# 🌐 APLIKASI — General Config
# ─────────────────────────────────────────

# Base URL aplikasi untuk keperluan internal
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment
NODE_ENV=development
